        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget Formatting Demo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demostración de formato del widget"
          }
        }
      }
