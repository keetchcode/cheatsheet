    "starterNote.gitFlow.body" : {
      "comment" : "First-run sample note body. Lines starting with 'git ' are shell commands and must stay in English/unmodified; only the heading and the quoted commit message placeholder are natural-language text.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Git Flow\n- git status\n- git switch -c feature/name\n- git add .\n- git commit -m \"Describe change\"\n- git push -u origin HEAD"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Flujo de Git\n- git status\n- git switch -c feature/nombre\n- git add .\n- git commit -m \"Describe el cambio\"\n- git push -u origin HEAD"
          }
        }
      }
    },
